config SHIELD_SPLIT_ERGO_TB_LEFT
    def_bool $(shields_list_contains,split_ergo_tb_left)
config SHIELD_SPLIT_ERGO_TB_RIGHT
    def_bool $(shields_list_contains,split_ergo_tb_right)


if SHIELD_SPLIT_ERGO_TB_RIGHT

config ZMK_KEYBOARD_NAME
    default "split_ergo_tb"

endif

if SHIELD_SPLIT_ERGO_TB_LEFT || SHIELD_SPLIT_ERGO_TB_RIGHT

config ZMK_SPLIT
    default y

endif
